{
  "schemaVersion": 1,
  "id": "parts-audio-connexion",
  "name": "PartsConnexion & AudioConnexion",
  "client": "Parts Connexion / Audio Connexion",
  "platform": "bigcommerce",
  "domains": [
    "partsconnexion.com",
    "www.partsconnexion.com",
    "audio-connexion.com",
    "www.audio-connexion.com",
    "pcx-72af9e2f5ce4.herokuapp.com"
  ],
  "sites": [
    {
      "hostname": "partsconnexion.com",
      "name": "PartsConnexion",
      "platform": "bigcommerce",
      "timeout": 30000,
      "retries": 2,
      "notes": "Audio/electronics components eCommerce. Built by WebDesk Solution. BigCommerce Stencil theme + Heroku Custom App.",
      "customApp": {
        "enabled": true,
        "hostname": "pcx-72af9e2f5ce4.herokuapp.com",
        "url": "https://pcx-72af9e2f5ce4.herokuapp.com/",
        "auth": {
          "usernameEnvVar": "PARTSCONNEXION_CUSTOMAPP_USERNAME",
          "passwordEnvVar": "PARTSCONNEXION_CUSTOMAPP_PASSWORD",
          "loginUrl": "https://pcx-72af9e2f5ce4.herokuapp.com/new/login/",
          "usernameSelector": "input[type=\"text\"]",
          "passwordSelector": "#auth-login-v2-password",
          "submitSelector": "button[type=\"submit\"]"
        },
        "safeNavTargets": [
          {
            "label": "Dashboard",
            "url": "https://pcx-72af9e2f5ce4.herokuapp.com/dashboards/ecommerce/"
          },
          {
            "label": "Cron Status",
            "url": "https://pcx-72af9e2f5ce4.herokuapp.com/new/cron-status/"
          },
          {
            "label": "Activity Logs",
            "url": "https://pcx-72af9e2f5ce4.herokuapp.com/new/logs/"
          },
          {
            "label": "Automatic Discount",
            "url": "https://pcx-72af9e2f5ce4.herokuapp.com/new/auto-discount/list/"
          }
        ],
        "discoveryApprovedBy": "client (chat approval)",
        "discoveryApprovedAt": "2026-08-12"
      },
      "currencies": [
        "USD",
        "CAD"
      ],
      "defaultCurrency": "USD",
      "manualCwv": {
        "mobileLcp": "1.1 s"
      },
      "archiveKey": "partsconnexion.com"
    },
    {
      "hostname": "audio-connexion.com",
      "name": "AudioConnexion",
      "platform": "bigcommerce",
      "timeout": 30000,
      "retries": 2,
      "notes": "Secondary eCommerce channel for audio components. Built by WebDesk Solution. BigCommerce Stencil theme.",
      "currencies": [
        "USD",
        "CAD"
      ],
      "defaultCurrency": "USD",
      "manualCwv": {
        "mobileLcp": "1.2 s",
        "mobileCls": "< 0.1"
      },
      "archiveKey": "audio-connexion.com"
    }
  ],
  "audits": {
    "performance": {
      "enabled": true,
      "pages": "all",
      "note": "PageSpeed Insights, median of 3. Measurements are stored for trend analysis; reports show the Before/After scores supplied in the prompt."
    },
    "security": {
      "enabled": true,
      "pages": "all",
      "authenticatedPass": true,
      "note": "Chrome DevTools/CDP: security headers, cookies, SRI, console errors, vulnerable libraries. The authenticated pass runs only when STOREFRONT_USERNAME/STOREFRONT_PASSWORD are set."
    },
    "dns": {
      "enabled": true
    },
    "ssl": {
      "enabled": true
    },
    "seo": {
      "enabled": true,
      "note": "Sitemap + crawl, canonical/robots/structured data, GEO/AEO readiness, multi-viewport layout."
    },
    "ai-crawlers": {
      "enabled": true,
      "note": "Derived from the seo crawl (robots.txt rules for GPTBot, Gemini, Claude, Perplexity ...)."
    },
    "network": {
      "enabled": true,
      "note": "Availability + response time (UptimeRobot when UPTIMEROBOT_API_KEY is set, live probe otherwise)."
    },
    "functional": {
      "enabled": false,
      "reason": "No generic storefront-journey runner exists yet (see docs/LIMITATIONS.md)."
    },
    "companion-app": {
      "enabled": true,
      "appliesTo": [
        "partsconnexion.com"
      ],
      "note": "Heroku custom app (read-only nav pass, write-request guardrail). AudioConnexion has no companion app."
    },
    "cache": {
      "enabled": false,
      "reason": "Server/build-cache metrics are captured manually from the hosting dashboard; no API runner exists yet."
    },
    "currency": {
      "enabled": true,
      "appliesTo": [
        "partsconnexion.com",
        "audio-connexion.com"
      ],
      "note": "USD/CAD price recalculation on homepage, category and PDP (guest session; never checkout)."
    }
  },
  "secrets": [
    {
      "env": "PAGESPEED_API_KEY",
      "purpose": "Google PageSpeed Insights API (performance audit)",
      "required": true,
      "scope": "environment"
    },
    {
      "env": "UPTIMEROBOT_API_KEY",
      "purpose": "UptimeRobot read-only API key (30-day availability); optional - a live probe is used without it",
      "required": false,
      "scope": "environment"
    },
    {
      "env": "STOREFRONT_USERNAME",
      "purpose": "Storefront customer login for the authenticated security pass; optional",
      "required": false,
      "scope": "environment"
    },
    {
      "env": "STOREFRONT_PASSWORD",
      "purpose": "Storefront customer password for the authenticated security pass; optional",
      "required": false,
      "scope": "environment"
    },
    {
      "env": "PARTSCONNEXION_CUSTOMAPP_USERNAME",
      "purpose": "PartsConnexion custom app login",
      "required": true,
      "scope": "environment"
    },
    {
      "env": "PARTSCONNEXION_CUSTOMAPP_PASSWORD",
      "purpose": "PartsConnexion custom app password",
      "required": true,
      "scope": "environment"
    }
  ],
  "reports": {
    "technical": "site-pdf",
    "client": "site-pptx"
  },
  "reportMeta": {
    "clientDisplayNames": {
      "partsconnexion.com": "PartsConnexion",
      "audio-connexion.com": "AudioConnexion"
    }
  }
}
