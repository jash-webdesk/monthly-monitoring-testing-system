# Secrets and sessions
.env
.env.*
!.env.example
*auth*.json
*storage-state*.json
*.pem
*.key

# Dependencies and caches
node_modules/
.cache/
scratch/
*.log

# Raw audit output (reports are copied to reports/<project>/<month>/ instead)
results/

