# Names only. Real values go in .env locally (ignored by git) or in the Claude Code cloud environment variables.

PAGESPEED_API_KEY=
UPTIMEROBOT_API_KEY=

# Optional authenticated storefront pass (use a dedicated low-privilege account)
STOREFRONT_USERNAME=
STOREFRONT_PASSWORD=

# Companion apps (use dedicated read-only monitoring users)
PARTSCONNEXION_CUSTOMAPP_USERNAME=
PARTSCONNEXION_CUSTOMAPP_PASSWORD=
GENPET_CUSTOMAPP_USERNAME=
GENPET_CUSTOMAPP_PASSWORD=
INTEGRITY_CUSTOMAPP_USERNAME=
INTEGRITY_CUSTOMAPP_PASSWORD=

# Sandbox tuning (all optional)
# CHROMIUM_EXECUTABLE_PATH=
# DNS_MODE=auto|native|doh
# SSL_MODE=auto|native|browser
# BROWSER_IGNORE_CERT_ERRORS=1
